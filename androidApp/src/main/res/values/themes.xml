<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="nascope_surface">#12141A</color>

    <!-- Dark window so there is never a white flash before Compose draws its first frame. -->
    <style name="Theme.Nascope" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nascope_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen shown while the process starts; replaced by Theme.Nascope via installSplashScreen(). -->
    <style name="Theme.Nascope.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nascope_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Nascope</item>
    </style>

</resources>
